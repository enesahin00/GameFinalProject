--- !u!114 &899098269
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 899098268}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 41a43306287e4564199988069f48f6aa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FpsHorrorKit.MindQuestionSystem
  questions:
  - questionText: '"Something is very wrong... The glass won''t break. Food has no
      taste. Where am I?"'
    triggerAtPiece: 3
    answers:
    - text: "\tI'm trapped in E's house."
      sanityChange: -15
      responseText: "\t\"No... That doesn't make sense.\""
    - text: "\tI'm in my own home."
      sanityChange: -15
      responseText: "\t\"My home never felt like this.\""
    - text: I'm dead and in purgatory
      sanityChange: -20
      responseText: '"Dead? No... I can still think. I can still feel."'
    - text: I'm not in the real world.
      sanityChange: 20
      responseText: "\"Nothing feels real... Am \u0131 dreaming ?\""
  - questionText: '"Time isn''t moving... I can''t even hear my own heartbeat. There''s
      a constant rhythmic sound in the background. What''s happening to me?"'
    triggerAtPiece: 7
    answers:
    - text: The house is haunted. Time has stopped.
      sanityChange: -15
      responseText: '"Houses don''t stop time. That can''t be right."'
    - text: "\tI'm too scared to hear my own heart."
      sanityChange: -10
      responseText: "\t\"Fear doesn't silence a heartbeat. Something else is wrong.\""
    - text: Thoose sounds... They're keeping me alive.
      sanityChange: 15
      responseText: '"That beeping sound... A hospital... Am I in a hospital?"'
    - text: "D\tI'm dead and in purgatory"
      sanityChange: -20
      responseText: '"Dead? No... I can still think. I can still feel."'
  - questionText: '"These notes... These rules... Who is E? Who has been helping
      me?"'
    triggerAtPiece: 10
    answers:
    - text: 'E is the one walking and knocking the doors , but why helping me '
      sanityChange: -40
      responseText: "\"I feel so sick there must be something \u0131 forgot\""
    - text: E is an old victim who lived here.
      sanityChange: -40
      responseText: "\t\"No... The handwriting. It's familier he must be someone
        i know"
    - text: E is the one who locked me in here.
      sanityChange: -40
      responseText: '"Then why leave notes to help me? That makes no sense."'
    - text: E is someone i know very well
      sanityChange: 40
      responseText: '"I''ve been talking to myself this whole time... guiding my
        own mind back." '
  questionPanel: {fileID: 591095700}
  questionText: {fileID: 20718216}
  answerTexts:
  - {fileID: 877750724}
  - {fileID: 1136110173}
  - {fileID: 406877344}
  - {fileID: 498862369}
  responsePanel: {fileID: 1632396502}
  responseText: {fileID: 975408993}
  responseDisplayTime: 3
