    - target: {fileID: 2899737726056450040, guid: eb87be1fb1853c14eb7feb36eee9b6f4, type: 3}
      propertyPath: m_text
      value: "\"I checked the front door again. Locked from the outside. I tried
        breaking the window in the study with a chair, but the glass won't shatter.
        It didn't even crack. It\u2019s like hitting a solid concrete wall. Who locked
        me in here? Why won't they let me out? - E.\""
      objectReference: {fileID: 0}
